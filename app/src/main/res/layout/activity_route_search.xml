<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_color">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_color"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card de búsqueda -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚌 Buscar Rutas de Transporte"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_color"
                        android:layout_marginBottom="16dp" />

                    <!-- Campo origen -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etOrigen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="¿Desde dónde viajas?"
                            android:drawableStart="@drawable/ic_bus"
                            android:drawablePadding="12dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Botón intercambiar -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIntercambiarParadas"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:text="⇅"
                        android:textSize="18sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_marginVertical="8dp" />

                    <!-- Campo destino -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDestino"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="¿A dónde vas?"
                            android:drawableStart="@drawable/ic_location_red"
                            android:drawablePadding="12dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Botón buscar -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuscarRutas"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="🔍 Buscar Rutas"
                        android:textSize="16sp"
                        style="@style/Widget.MaterialComponents.Button" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Sugerencias de origen -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSugerenciasOrigen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Paradas de origen sugeridas:"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/secondary_text_color"
                        android:padding="12dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSugerenciasOrigen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxHeight="200dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Sugerencias de destino -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSugerenciasDestino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Paradas de destino sugeridas:"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/secondary_text_color"
                        android:padding="12dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSugerenciasDestino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxHeight="200dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Resultados de rutas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛣️ Rutas Disponibles"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text_color"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvResultadosRutas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
