<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- NUEVO: Layout para item de chofer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header con ID y nombre -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvDriverId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: CH001"
                android:textSize="12sp"
                android:textColor="@color/primary_color"
                android:background="@drawable/id_badge_background"
                android:padding="4dp"
                android:layout_marginEnd="8dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👨‍💼"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Nombre del chofer -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Juan Pérez García"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text_color"
            android:layout_marginBottom="8dp" />

        <!-- Unidad asignada -->
        <TextView
            android:id="@+id/tvUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unidad: Autobús 001"
            android:textSize="14sp"
            android:textColor="@color/secondary_text_color"
            android:drawableStart="@drawable/ic_bus"
            android:drawablePadding="8dp"
            android:layout_marginBottom="4dp" />

        <!-- Teléfono -->
        <TextView
            android:id="@+id/tvPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📞 555-1234"
            android:textSize="14sp"
            android:textColor="@color/secondary_text_color"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <!-- Email -->
        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📧 juan@example.com"
            android:textSize="14sp"
            android:textColor="@color/secondary_text_color"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- Fecha de registro -->
        <TextView
            android:id="@+id/tvCreatedDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrado: 15 Ene 2025"
            android:textSize="12sp"
            android:textColor="@color/secondary_text_color"
            android:drawableStart="@drawable/ic_calendar"
            android:drawablePadding="4dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
